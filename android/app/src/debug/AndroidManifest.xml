<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter tooling and the local relay used by debug builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true">
        <!-- Debug-only hook used by the two-emulator keyguard test. It is not
             merged into release APKs. -->
        <receiver
            android:name=".KnockDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.pulseapp.pulse.DEBUG_KNOCK" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".LockscreenRayDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.pulseapp.pulse.DEBUG_RAY_EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
