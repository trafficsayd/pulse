<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pulse</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>pulse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Pulse uses Bluetooth Low Energy to discover and connect to a paired phone nearby. No data leaves the two devices.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Pulse uses Bluetooth Low Energy to be discovered by a paired phone nearby. No data leaves the two devices.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pulse uses the local Wi-Fi network to keep your direct connection alive when Bluetooth is out of range. No data leaves the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pulse._tcp</string>
		<string>_pulse._udp</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pulse uses the microphone to detect whispers, blowing, and ambient sound in modes like Whisper, Candle, and Bubble. Audio never leaves your phone.</string>
	<key>NSCameraUsageDescription</key>
	<string>Pulse uses the camera to capture colors and light pulses in modes like Lens and Morse. Frames never leave your phone.</string>
	<key>NSMotionUsageDescription</key>
	<string>Pulse uses motion sensors for modes like Bell, Cradle, and Balance.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>audio</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
