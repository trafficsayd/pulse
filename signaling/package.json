{
  "name": "pulse-signaling",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that brokers WebRTC SDP / ICE for two Pulse peers behind separate NATs.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.31",
    "@cloudflare/workers-types": "^4.20250520.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "2.1.4",
    "wrangler": "^3.86.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
